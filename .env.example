# 复制为 .env 后填写（.env 已在 .gitignore 中，切勿提交）

# @BotFather 申请的 Bot Token（必填）
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# E-Hentai / ExHentai 登录 Cookie（访问里站需要；只用表站可留空）
EH_IPB_MEMBER_ID=YOUR_IPB_MEMBER_ID
EH_IPB_PASS_HASH=YOUR_IPB_PASS_HASH
EH_IGNEOUS=YOUR_IGNEOUS
EH_SK=

# catbox.moe 账号 userhash（可选；留空则使用 litterbox 72 小时临时图床）
CATBOX_USERHASH=
